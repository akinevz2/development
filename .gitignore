# Resume generated files
resume/*.html
resume/*.pdf

# winxp.css is cloned, not tracked
resume/winxp.css/
resume/xp.css/

# Node modules
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/settings.json

# Tooling pollution
.bsp/
.github/
.metals/
.bloop
.scala-build/

# Local credentials (never commit)
.my-credentials

# Ignore all files inside internet/ directory
internet/*

# Extra temporary submodules
system/*
!system/drop.mjs
!system/keybindings.json

# OpenWebUI service definition is tracked; storage/artifacts are not
!system/openwebui
system/openwebui/*
!system/openwebui/Dockerfile
!system/openwebui/docker-compose.yml
!system/openwebui/.dockerignore

# System monitoring project tracked in its entirety; build artifacts are not
!system/monitoring
system/monitoring/node_modules/
system/monitoring/src/viewer/dist/
system/monitoring/dist/
system/monitoring/bin/

# Twitch scraper: local WIP, not ready to track
twitch-category-scraper/