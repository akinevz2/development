{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama_wsrarebox/laguna-xs-2.1:latest",
  "provider": {
    "ollama_wsrarebox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama - WS-RAREBOX (24GB VRAM)",
      "options": {
        "baseURL": "http://ws-rarebox.lan:11434/v1"
      }
    },
    "ollama_v9mini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama - V9-MINI (16GB VRAM)",
      "options": {
        "baseURL": "http://v9-mini.lan:11434/v1"
      }
    },
    "ollama_wsvision": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama - WS-VISION (8GB VRAM)",
      "options": {
        "baseURL": "http://ws-vision.lan:11434/v1"
      }
    },
    "ollama_local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama (localhost)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  }
}