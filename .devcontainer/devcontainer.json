// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "Vue.volar",
        "redhat.java",
        "ms-azuretools.vscode-containers",
        "Ollama.ollama",
        "ltmoerdani.opencode-copilot-chat"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  // Features are optional; keep this minimal and add only what you need later.
  "features": {
    "ghcr.io/devcontainers/features/python:latest": {
      "version": "latest",
      "installJupyterlab": true,
      "installTools": true,
      "optimize": true
    },
    "ghcr.io/devcontainers/features/java:latest": {
      "version": "latest",
      "jdkDistro": "ms",
      "installMaven": true
    }
  },
  // Forward the WSL host's ssh-agent into the container so git/gh can use the
  // host's SSH key. The private key never enters the container filesystem.
  // Requires the WSL host to have ssh-agent running with the key added.
  // Mounted into the container user's $HOME so the socket is accessible
  // regardless of the host user's home path (e.g. /home/kine vs /home/vscode).
  // "mounts": [
  //   "source=${localEnv:SSH_AUTH_SOCK},target=/home/vscode/.ssh-agent,type=bind"
  // ],
  // Forward Ollama port from WSL host (0.0.0.0:11434) into the container
  "portsAttributes": {
    "11434": {
      "label": "Ollama",
      "onAutoForward": "notify"
    }
  },
  // Persistent cache mounts
  "name": "Development Workstation",
  "workspaceFolder": "/workspaces/development",
  // Run the update-dots bootstrap after the container is created and on each start.
  "postStartCommand": "bash .devcontainer/update-dots.sh",
  "postAttachCommand": "bash .devcontainer/setup-ollama.sh && .devcontainer/update-dots.sh",
  // Environment variables
  "containerEnv": {
    "EDITOR": "code --wait",
    "ALIASES": "~/.config/aliases",
    "dotfiles": "https://github.com/akinevz2/doftiles.git",
    "OLLAMA_HOST": "localhost"
  },
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/home/vscode/.ssh-agent",
    "OLLAMA_HOST": "localhost"
  },
  "containerUser": "vscode",
  "runArgs": [
    "--network",
    "host"
  ]
}