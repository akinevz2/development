// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "redhat.vscode-quarkus",
        "tamasfe.even-better-toml",
        "editorconfig.editorconfig",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "scalameta.metals",
        "scala-lang.scala",
        "ms-python.python",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "Ollama.ollama",
        "Vue.volar",
        "redhat.java"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "bash",
        "metals.sbtScript": "${userHome}/.sdkman/candidates/sbt/current/bin/sbt",
        "metals.showInferredType": true,
        "metals.bloopSbtAlreadyInstalled": false
      }
    }
  },
  // Features are optional; keep this minimal and add only what you need later.
  "features": {
    "ghcr.io/devcontainers/features/python:latest": {
      "version": "latest",
      "installJupyterlab": true,
      "installTools": true,
      "optimize": false
    },
    "ghcr.io/devcontainers/features/java:latest": {
      "version": "21",
      "jdkDistro": "ms",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/rust:latest": {
      "version": "latest",
      "profile": "default"
    },
    "ghcr.io/devcontainers-extra/features/scalacli-sdkman": {
      "version": "latest",
      "jdkDistro": "ms",
      "jdkVersion": "21"
    },
    "ghcr.io/devcontainers-extra/features/scala-sdkman": {
      "version": "latest",
      "jdkDistro": "ms",
      "jdkVersion": "21"
    }
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [],
  // Forward the WSL host's ssh-agent into the container so git/gh can use the
  // host's SSH key. The private key never enters the container filesystem.
  // Requires the WSL host to have ssh-agent running with the key added.
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
  ],
  // Persistent cache mounts
  "name": "Development Workstation",
  "workspaceFolder": "/workspaces/development",
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Environment variables
  "containerEnv": {
    "EDITOR": "code --wait",
    "ALIASES": "~/.config/aliases"
  },
  "remoteEnv": {
    "dotfiles": "https://github.com/akinevz2/configs.git",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  "otherPortsAttributes": {
    "onAutoForward": "notify"
  },
  "portsAttributes": {
    "11434": {
      "label": "Ollama",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  }
}