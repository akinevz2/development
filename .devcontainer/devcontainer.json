// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:latest",
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "redhat.vscode-quarkus",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "streetsidesoftware.code-spell-checker",
        "usernamehw.errorlens",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  // Features are optional; keep this minimal and add only what you need later.
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem",
      "installMaven": true
    }
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [],
  // Persistent cache mounts
  "mounts": [],
  "runArgs": [
    "--network=slirp4netns:allow_host_loopback=true",
    "--add-host=minifridge:192.168.1.122",
    "--add-host=ws-raretower:192.168.137.133"
  ],
  "name": "Development Workstation",
  "workspaceFolder": "/workspaces/development",
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Environment variables
  "containerEnv": {
    "MY_CREDENTIALS": "/workspaces/development/.my-credentials"
  },
  "remoteEnv": {
    "dotfiles": "https://github.com/akinevz2/configs.git",
    "EDITOR": "code --wait"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}